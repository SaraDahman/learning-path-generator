# Copy this file to .env and fill in the values. Supabase values come from
# project settings (Project Settings -> API); the Gemini key from Google AI
# Studio. The server loads .env automatically.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required by the Express server for the protected profile insert.
# Keep this server-side only; never expose it as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Required by the Express server for learning path generation.
# Server-side only. Never rename it to a VITE_ variable, or Vite will inline
# it into the client bundle and ship the key to every visitor.
GEMINI_API_KEY=

# Optional. Comma-separated fallback chain, tried in order. Only override this
# if the defaults start failing; model availability changes without notice
# (gemini-2.5-flash is already retired for new accounts).
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.7-flash
