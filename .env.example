# Copy this file to .env and fill in the values from your Supabase project
# settings (Project Settings -> API). The server loads .env automatically.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required by the Express server for the protected profile insert.
# Keep this server-side only; never expose it as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
